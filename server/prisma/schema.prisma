generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  ANNUAL
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role UserRole @default(USER)
  createdAt DateTime @default(now())
  transactions Transaction[]
  habits Habit[]
  goals Goal[]
  assets Asset[]
  incomeSources IncomeSource[]
  feedback Feedback[]
}

model Transaction {
  id String @id @default(cuid())
  amount Decimal @db.Decimal(12, 2)
  type TransactionType
  category String
  note String?
  date DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId String?
  source IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model IncomeSource {
  id String @id @default(cuid())
  name String
  amount Decimal @db.Decimal(12, 2)
  frequency Frequency
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt DateTime @default(now())
}

model Habit {
  id String @id @default(cuid())
  name String
  frequency Frequency
  reminderTime String?
  createdAt DateTime @default(now())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
}

model HabitCompletion {
  id String @id @default(cuid())
  completedOn DateTime @db.Date
  habitId String
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  @@unique([habitId, completedOn])
}

model Goal {
  id String @id @default(cuid())
  name String
  targetAmount Decimal @db.Decimal(12, 2)
  currentAmount Decimal @default(0) @db.Decimal(12, 2)
  targetDate DateTime?
  icon String @default("🎯")
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Asset {
  id String @id @default(cuid())
  name String
  type String
  category String @default("Investment")
  value Decimal @db.Decimal(12, 2)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

model Feedback {
  id String @id @default(cuid())
  message String
  status String @default("OPEN")
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
